<%
const NAV_ICONS = {
  home: '<path d="M4 10.6 12 4l8 6.6V20a1 1 0 0 1-1 1h-4.2v-6H9.2v6H5a1 1 0 0 1-1-1z"/>',
  archives: '<path d="M3.5 7.5h17v3h-17z"/><path d="M5.5 10.5V19a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-8.5"/><path d="M10 14.5h4"/>',
  tags: '<path d="M20.6 12.6l-8 8a2 2 0 0 1-2.8 0l-6.4-6.4a2 2 0 0 1-.6-1.4V5a2 2 0 0 1 2-2h7.8a2 2 0 0 1 1.4.6l6.6 6.6a2 2 0 0 1 0 2.4z"/><circle cx="7.6" cy="7.6" r="1.1"/>',
  categories: '<path d="M4 6.5A1.5 1.5 0 0 1 5.5 5h3.1l2 2H18.5A1.5 1.5 0 0 1 20 8.5V18a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18z"/>',
  link: '<path d="M9.5 14.5l5-5"/><path d="M11.2 7.6l1.4-1.4a3.7 3.7 0 0 1 5.2 5.2l-1.4 1.4"/><path d="M12.8 16.4l-1.4 1.4a3.7 3.7 0 0 1-5.2-5.2l1.4-1.4"/>'
};
const navIconKey = (link) => {
  const seg = String(link).replace(/^\/+/, '').replace(/\/+$/, '').split('/')[0];
  return seg === '' ? 'home' : (NAV_ICONS[seg] ? seg : 'link');
};
%>
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="<%= helpers.url('/') %>">
      <% if (site.logo) { %><img class="brand-logo" src="<%= helpers.url(site.logo) %>" alt="<%= site.title %>"><% } %>
      <span class="brand-text">
        <span class="brand-title"><%= site.title %></span>
        <% if (site.subtitle) { %><span class="brand-subtitle"><%= site.subtitle %></span><% } %>
      </span>
    </a>

    <button class="icon-button nav-toggle" type="button" aria-label="展开导航" aria-expanded="false" data-nav-toggle>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>

    <nav class="site-nav" data-nav aria-label="站内导航">
      <% for (const item of nav) { %>
        <% const target = helpers.url(item.link); %>
        <% const active = item.link === '/' ? page.type === 'index' : page.url.indexOf(target) === 0; %>
        <a class="nav-link<%= active ? ' is-active' : '' %>" href="<%= target %>"<%= active ? ' aria-current="page"' : '' %>>
          <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><%- NAV_ICONS[navIconKey(item.link)] %></svg>
          <span><%= item.text %></span>
        </a>
      <% } %>
    </nav>

    <% if (theme.showSearch) { %>
      <button class="icon-button search-open" type="button" aria-label="搜索文章" aria-keyshortcuts="Control+K" data-search-open data-search-url="<%= helpers.url('/search.json') %>">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15.6 15.6 20.5 20.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    <% } %>

    <button class="icon-button theme-toggle" type="button" aria-label="切换深色模式" data-theme-toggle>
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
    </button>
  </div>
</header>