<article class="post-card">
  <div class="post-card-headline">
    <h2 class="post-card-title"><a href="<%= post.url %>"><%= post.title %></a></h2>
    <div class="post-card-dates">
      <time class="post-card-date" datetime="<%= helpers.dateTime(post.date) %>"><%= helpers.formatDate(post.date) %></time>
      <% if (post.updated !== post.date) { %>
        <span class="sep" aria-hidden="true">·</span>
        <time class="post-card-updated" datetime="<%= helpers.dateTime(post.updated) %>" title="最后修订 <%= post.updated %>">修订 <%= helpers.formatDate(post.updated) %></time>
      <% } %>
    </div>
  </div>
  <% if (post.excerpt) { %><p class="post-card-excerpt"><%= post.excerpt %></p><% } %>
  <div class="post-card-meta">
    <% for (const category of post.categories) { %><a class="post-card-cat" href="<%= category.url %>"><%= category.name %></a><% } %>
    <% if (post.categories.length > 0 && theme.showReadingTime) { %><span class="sep">·</span><% } %>
    <% if (theme.showReadingTime) { %><span><%= helpers.readingLabel(post.readingTime) %></span><% } %>
    <% if (post.state === 'draft') { %><span class="badge badge-draft">草稿</span><% } %>
    <% if (post.state === 'scheduled') { %><span class="badge badge-scheduled">定时</span><% } %>
    <% if (post.pinned) { %><span class="badge badge-pinned">置顶</span><% } %>
  </div>
  <% if (post.tags.length > 0) { %>
    <div class="post-card-taxonomy">
      <% for (const tag of post.tags) { %><a class="chip" href="<%= tag.url %>">#<%= tag.name %></a><% } %>
    </div>
  <% } %>
</article>