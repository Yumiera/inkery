{
  "name": "inkery",
  "version": "0.1.0",
  "private": true,
  "description": "Inkery — 可视化轻量级静态博客框架",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "blog": "tsx src/cli/index.ts",
    "dev": "tsx src/cli/index.ts dev",
    "build": "tsx src/cli/index.ts build",
    "new": "tsx src/cli/index.ts new",
    "ls": "tsx src/cli/index.ts ls",
    "render": "tsx src/cli/index.ts render",
    "deploy": "tsx src/cli/index.ts deploy",
    "build:admin": "vite build admin",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p admin/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@shikijs/langs": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "chokidar": "^5.0.0",
    "ejs": "^7.0.1",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.13",
    "image-size": "^2.0.4",
    "js-yaml": "^5.4.3",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mathjax-full": "^3.2.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.3",
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.20.5",
    "preact": "^10.29.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "wouter": "^3.13.0"
  }
